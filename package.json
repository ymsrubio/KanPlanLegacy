{
  "name": "kanplan",
  "version": "1.0.0",
  "description": "KanPlan — Agile Kanban WIP Limits + Calendar Time Blocking",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev --d1 DB=kanplan_db --port 8788 -- vite --port 5173",
    "dev:api": "wrangler pages dev --d1 DB=kanplan_db --port 8788",
    "build": "vite build",
    "preview": "wrangler pages dev dist --d1 DB=kanplan_db",
    "test": "node --test tests/*.test.js",
    "db:init": "wrangler d1 execute kanplan_db --local --file=db/schema.sql"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunaayumii/KanPlan.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yunaayumii/KanPlan/issues"
  },
  "homepage": "https://github.com/yunaayumii/KanPlan#readme",
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@hello-pangea/dnd": "^18.0.1",
    "hono": "^4.13.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@vitejs/plugin-react": "^6.0.5",
    "better-sqlite3": "^13.0.3",
    "vite": "^8.2.0",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260801.1": true
  }
}
